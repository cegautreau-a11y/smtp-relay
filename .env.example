# ─────────────────────────────────────────────────────────────────────
# SMTP Mail Relay – environment variables (Docker)
#
# FIRST BOOT ONLY: these variables are applied once, while the database
# is still empty. They seed the relay_config table; after that the
# database owns the configuration and changes to these variables are
# IGNORED on startup. Empty the database (or the Docker volume) to
# re-apply environment variables on next start.
# See docs/CONFIGURATION.md for details.
# ─────────────────────────────────────────────────────────────────────

# Database (REQUIRED — PostgreSQL is the only supported backend, v4.3.0+)
# The in-stack postgres service (see docker-compose.yml) uses POSTGRES_PASSWORD:
POSTGRES_PASSWORD=change-me-to-a-random-password
# Override DATABASE_URL to point at an external PostgreSQL server instead:
# DATABASE_URL=postgresql+psycopg2://smtp:password@db.example.com:5432/smtp_relay

# Flask
SECRET_KEY=change-me-to-a-random-secret
WEB_HOST=0.0.0.0
# NOTE: inside Docker the in-container web port is FIXED at 8025 (the
# compose files pin it to match the port mapping); WEB_PORT below only
# applies to non-Docker installs. Remap the HOST side with WEB_PORT_HOST.
WEB_PORT=8025
# web request threads (feeds the gunicorn thread count; ignored by the Windows dev-server fallback)
WEB_THREADS=4
WEB_SECURE_COOKIES=false
# Key the login throttle on X-Forwarded-For. Enable ONLY when a trusted
# reverse proxy actually fronts the app — clients can spoof the header.
# Behind an HTTPS proxy set BOTH of these:
#   WEB_SECURE_COOKIES=true + WEB_TRUST_PROXY=true
# and set an exact azure_redirect_uri in the web UI (see
# docs/REVERSE_PROXY.md for a full nginx/Caddy example).
WEB_TRUST_PROXY=false

# Host-side port mappings (Docker/Portainer only — container ports stay 8025/2525).
# Change these when the Portainer host already has a service on the default ports.
# WEB_PORT_HOST=8025
# SMTP_PORT_HOST=2525

# SMTP Listener
SMTP_LISTEN_HOST=0.0.0.0
# NOTE: inside Docker the in-container SMTP port is FIXED at 2525 (the
# compose files pin it to match the port mapping); SMTP_LISTEN_PORT below
# only applies to non-Docker installs. Remap the HOST side with SMTP_PORT_HOST.
SMTP_LISTEN_PORT=2525
BANNER_HOSTNAME=relay.local
REQUIRE_AUTH=true
ENABLE_TLS=false
TLS_CERT_PATH=
TLS_KEY_PATH=

# Delivery Mode (relay or direct)
DELIVERY_MODE=relay

# Relay Mode Settings
RELAY_HOST=smtp.example.com
RELAY_PORT=25
RELAY_USE_TLS=false
RELAY_USE_STARTTLS=true
RELAY_AUTH_USER=
RELAY_AUTH_PASSWORD=
RELAY_HELO_HOSTNAME=localhost

# Direct Delivery Settings (used when DELIVERY_MODE=direct)
DIRECT_USE_STARTTLS=false
DIRECT_AUTH_USER=
DIRECT_AUTH_PASSWORD=

# Limits
MAX_MESSAGE_SIZE=26214400
MAX_RECIPIENTS=100
GLOBAL_RATE_LIMIT=1000
ALLOWED_SOURCE_IPS=

# Queue
QUEUE_RETRY_INTERVAL=300
QUEUE_MAX_RETRIES=3

# Logging
# App log file — rotated (20 MB x 5). In Docker it defaults to
# /app/data/relay.log (on the smtp-data volume); empty = stdout only.
# Read on EVERY boot — logging starts before the database is reachable.
LOG_FILE=/app/data/relay.log
LOG_RETENTION_DAYS=30
# Seeds the Debug Logging toggle (Configuration page) on first boot;
# afterwards that page owns it. When on, writes data/smtp_debug.log
# (rotated 50 MB x 5) and turns on DEBUG-level logging.
DEBUG_LOGGING=false
